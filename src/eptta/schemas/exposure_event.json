{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EP-TTA exposure event 0.1.0",
  "type": "object",
  "properties": {
    "schema_version": {"type": "string", "enum": ["0.1.0"]},
    "event_id": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "enum": ["metadata_view", "sample_debug", "model_scoring", "effect_view", "method_selection"]},
    "artifact_ref": {"type": "string", "minLength": 1},
    "artifact_sha256": {"type": "string", "minLength": 64},
    "effect_visible": {"type": "boolean"},
    "decision_impact": {"type": "string", "minLength": 1},
    "previous_event_sha256": {"type": ["string", "null"]},
    "event_sha256": {"type": "string", "minLength": 64}
  },
  "required": ["schema_version", "event_id", "recorded_at", "dataset_id", "scope", "event_type", "artifact_ref", "artifact_sha256", "effect_visible", "decision_impact", "previous_event_sha256", "event_sha256"],
  "additionalProperties": false
}
