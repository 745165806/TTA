{
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "0.1.0"
      ],
      "type": "string"
    },
    "status": {
      "enum": [
        "UNRESOLVED",
        "PROPOSED",
        "APPROVED",
        "LOCKED"
      ],
      "type": "string"
    },
    "approval": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "minLength": 1
        },
        "report_ref": {
          "type": "string",
          "minLength": 1
        },
        "sample_evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "reviewer",
        "approved_at",
        "report_ref",
        "sample_evidence_ref",
        "content_sha256"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "policy_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "raw_to_canonical": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          }
        },
        "unknown_policy": {
          "enum": [
            "quarantine",
            "error"
          ],
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "policy_id",
        "raw_to_canonical",
        "unknown_policy"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "approval",
    "payload"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EP-TTA label 0.1.0"
}
