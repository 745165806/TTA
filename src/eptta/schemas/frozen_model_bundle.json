{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EP-TTA production FrozenModelBundle 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "model_id", "baseline_id", "selected_checkpoint_sha256",
    "training_run_id", "fit_snapshot_hash", "source_val_snapshot_hash", "recipe_hash",
    "init_provenance", "task_training_provenance", "eval_preprocess_hash",
    "class_index_map", "head_ref", "embedding_dim", "training_status", "training_phase",
    "task_weight_origin", "source_val_selection_ref", "parity_report_ref", "model_contract",
    "score_contract", "numerical_contract", "r4_validation", "export_code_sha256"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["0.1.0"]},
    "model_id": {"type": "string", "enum": ["aasist_source", "ssl_aasist_source"]},
    "baseline_id": {"type": "string", "minLength": 1},
    "selected_checkpoint_sha256": {"type": "string", "minLength": 64},
    "training_run_id": {"type": "string", "minLength": 1},
    "fit_snapshot_hash": {"type": "string", "minLength": 64},
    "source_val_snapshot_hash": {"type": "string", "minLength": 64},
    "recipe_hash": {"type": "string", "minLength": 64},
    "init_provenance": {"type": "object"},
    "task_training_provenance": {"type": "object"},
    "eval_preprocess_hash": {"type": "string", "minLength": 64},
    "class_index_map": {
      "type": "object", "additionalProperties": false,
      "required": ["bonafide", "spoof"],
      "properties": {"bonafide": {"type": "integer"}, "spoof": {"type": "integer"}}
    },
    "head_ref": {"type": "string", "minLength": 1},
    "embedding_dim": {"type": "integer", "minimum": 1},
    "training_status": {"type": "string", "enum": ["FINALIZED"]},
    "training_phase": {"type": "string", "enum": ["full"]},
    "task_weight_origin": {"type": "string", "enum": ["trained_in_project"]},
    "source_val_selection_ref": {"type": "string", "minLength": 1},
    "parity_report_ref": {"type": "string", "minLength": 1},
    "model_contract": {"type": "object"},
    "score_contract": {"type": "object"},
    "numerical_contract": {"type": "object"},
    "r4_validation": {"type": "object"},
    "export_code_sha256": {"type": "string", "minLength": 64}
  }
}
