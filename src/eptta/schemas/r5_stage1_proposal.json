{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EP-TTA R5 stage-1 review proposal 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "approval_required", "locks_published", "proposal_id",
    "parent_plan_ref", "parent_plan_sha256", "bundle_ref", "bundle_sha256", "bundle_id",
    "export_manifest_sha256", "checkpoint_sha256", "training_seed", "source_snapshot_ref",
    "source_snapshot_sha256", "worker_ref", "worker_sha256", "views", "view_index", "probe",
    "probe_sha256", "numerical_mode", "transform_contract", "roles", "commands_after_review_lock",
    "real_block_coverage", "implementation_gaps_before_lock", "budget", "forbidden"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["0.1.0"]},
    "status": {"type": "string", "enum": ["PROPOSED"]},
    "approval_required": {"type": "boolean", "enum": [true]},
    "locks_published": {"type": "boolean", "enum": [false]},
    "proposal_id": {"type": "string", "minLength": 1},
    "parent_plan_ref": {"type": "string", "minLength": 1},
    "parent_plan_sha256": {"type": "string", "minLength": 64},
    "bundle_ref": {"type": "string", "minLength": 1},
    "bundle_sha256": {"type": "string", "minLength": 64},
    "bundle_id": {"type": "string", "minLength": 1},
    "export_manifest_sha256": {"type": "string", "minLength": 64},
    "checkpoint_sha256": {"type": "string", "minLength": 64},
    "training_seed": {"type": "integer"},
    "source_snapshot_ref": {"type": "string", "minLength": 1},
    "source_snapshot_sha256": {"type": "string", "minLength": 64},
    "worker_ref": {"type": "string", "minLength": 1},
    "worker_sha256": {"type": "string", "minLength": 64},
    "views": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "view_index": {"type": "object"},
    "probe": {"type": "object"},
    "probe_sha256": {"type": "string", "minLength": 64},
    "numerical_mode": {"type": "object"},
    "transform_contract": {"type": "object"},
    "roles": {"type": "object"},
    "commands_after_review_lock": {"type": "object"},
    "real_block_coverage": {"type": "string", "minLength": 1},
    "implementation_gaps_before_lock": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "budget": {"type": "object"},
    "forbidden": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
