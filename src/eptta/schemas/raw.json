{
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "0.1.0"
      ],
      "type": "string"
    },
    "status": {
      "enum": [
        "UNRESOLVED",
        "PROPOSED",
        "APPROVED",
        "LOCKED"
      ],
      "type": "string"
    },
    "approval": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "minLength": 1
        },
        "report_ref": {
          "type": "string",
          "minLength": 1
        },
        "sample_evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "reviewer",
        "approved_at",
        "report_ref",
        "sample_evidence_ref",
        "content_sha256"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "format": {
          "enum": [
            "delimited",
            "json",
            "jsonl",
            "sidecar",
            null
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "dataset_release": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "encoding": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "delimiter": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "header": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "columns": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "json_paths": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "record_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "audio_path_rule": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "label_field": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "allowed_values": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "missing_policy": {
          "type": ["string", "null"],
          "enum": ["error", "quarantine", null]
        },
        "protocol_globs": {
          "type": ["array", "null"],
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "protocol_contexts": {
          "type": ["object", "null"],
          "additionalProperties": {
            "type": "object",
            "properties": {
              "root_key": {"type": "string", "minLength": 1},
              "official_split": {"type": ["string", "null"]},
              "audio_path_template": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false,
            "required": ["root_key", "official_split", "audio_path_template"]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "format",
        "dataset_release",
        "encoding",
        "delimiter",
        "header",
        "columns",
        "json_paths",
        "record_id",
        "audio_path_rule",
        "label_field",
        "allowed_values",
        "missing_policy",
        "protocol_globs",
        "protocol_contexts"
      ]
    }
