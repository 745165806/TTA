{
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "0.1.0"
      ],
      "type": "string"
    },
    "status": {
      "enum": [
        "UNRESOLVED",
        "PROPOSED",
        "APPROVED",
        "LOCKED"
      ],
      "type": "string"
    },
    "approval": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "minLength": 1
        },
        "report_ref": {
          "type": "string",
          "minLength": 1
        },
        "sample_evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "reviewer",
        "approved_at",
        "report_ref",
        "sample_evidence_ref",
        "content_sha256"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "repo_commit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "patch_sha256": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "config_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "class_index_map": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "bonafide": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            },
            "spoof": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "bonafide",
            "spoof"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "repo_commit",
        "patch_sha256",
        "config_ref",
        "class_index_map"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "approval",
    "payload"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EP-TTA architecture 0.1.0"
}
