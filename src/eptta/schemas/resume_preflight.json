{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EP-TTA resume preflight 0.1.0",
  "type": "object",
  "properties": {
    "schema_version": {"type": "string", "enum": ["0.1.0"]},
    "status": {"type": "string", "enum": ["PASS", "APPROVAL_REQUIRED", "BLOCKED"]},
    "read_only": {"type": "boolean", "enum": [true]},
    "route": {"type": "string", "enum": ["exact", "child"]},
    "execution_ready": {"type": "boolean"},
    "run_dir": {"type": "string", "minLength": 1},
    "run_id_recorded": {"type": ["string", "null"]},
    "deterministic_completion_run_id": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "training_seed": {"type": "integer", "minimum": 0},
    "phase": {"type": "string", "minLength": 1},
    "source_job_sha256": {"type": "string", "minLength": 64},
    "checkpoint_ref": {"type": "string", "minLength": 1},
    "checkpoint_sha256": {"type": "string", "minLength": 64},
    "checkpoint_epoch": {"type": "integer", "minimum": 0},
    "resume_start_epoch": {"type": "integer", "minimum": 1},
    "global_step": {"type": "integer", "minimum": 1},
    "steps_per_epoch": {"type": ["integer", "null"]},
    "expected_global_step": {"type": ["integer", "null"]},
    "locked_max_epochs": {"type": "integer", "minimum": 1},
    "target_max_epochs": {"type": "integer", "minimum": 1},
    "recipe_hash": {"type": "string", "minLength": 64},
    "snapshot_hashes": {"type": "object"},
    "architecture": {"type": "object"},
    "initialization": {"type": ["object", "null"]},
    "training_patch_sha256": {"type": ["string", "null"]},
    "optimizer_state_present": {"type": "boolean"},
    "optimizer_lrs": {"type": "array", "items": {"type": "number"}},
    "scheduler": {"type": ["string", "null"]},
    "scheduler_state_present": {"type": "boolean"},
    "scheduler_position": {"type": ["object", "null"]},
    "scaler_state_present": {"type": "boolean"},
    "rng_rank_count": {"type": ["integer", "null"]},
    "sampler_state": {"type": "object"},
    "best_selection_record": {"type": ["object", "null"]},
    "bound_worker_ref": {"type": ["string", "null"]},
    "bound_worker_sha256": {"type": ["string", "null"]},
    "candidate_worker_ref": {"type": "string", "minLength": 1},
    "candidate_worker_sha256": {"type": "string", "minLength": 64},
    "stop_reason": {"type": ["string", "object"]},
    "train_log_sha256": {"type": ["string", "null"]},
    "metrics_sha256": {"type": ["string", "null"]},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["schema_version", "status", "read_only", "route", "execution_ready", "run_dir", "run_id_recorded", "deterministic_completion_run_id", "model_id", "training_seed", "phase", "source_job_sha256", "checkpoint_ref", "checkpoint_sha256", "checkpoint_epoch", "resume_start_epoch", "global_step", "steps_per_epoch", "expected_global_step", "locked_max_epochs", "target_max_epochs", "recipe_hash", "snapshot_hashes", "architecture", "initialization", "training_patch_sha256", "optimizer_state_present", "optimizer_lrs", "scheduler", "scheduler_state_present", "scheduler_position", "scaler_state_present", "rng_rank_count", "sampler_state", "best_selection_record", "bound_worker_ref", "bound_worker_sha256", "candidate_worker_ref", "candidate_worker_sha256", "stop_reason", "train_log_sha256", "metrics_sha256", "blockers", "warnings"],
  "additionalProperties": false
}
